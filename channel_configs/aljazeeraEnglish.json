{
  "id": "aljazeeraEnglish",
  "channel_name": "Al Jazeera English",
  "channel_icon": " قناة",
  "stream_url": "http://live-hls-web-aje-fa.thehlive.com/AJE/index.m3u8",
  "language": "en",
  "output_dir": "/home/mehanic/Downloads/news_output",
  "frame": {
    "width": 960,
    "height": 540,
    "fps": 3,
    "sample_every_frames": 15,
    "diagnostic_every_frames": 50,
    "stats_every_frames": 100
  },
  "ocr": {
    "detection_model": "PP-OCRv5_mobile_det",
    "recognition_model": "en_PP-OCRv5_mobile_rec",
    "profile": "english",
    "min_score": 0.25
  },
  "layout": {
    "strategy": "white_rows_english"
  },
  "urgent_detection": {
    "mode": "keywords"
  },
  "text": {
    "garbage_profile": "english",
    "preprocess_profile": "english",
    "ticker_stopwords": [
      "GMT",
      "UTC",
      "غرينتش",
      "مكة"
    ],
    "urgent_keywords": [
      "ALERT",
      "BREAKING",
      "BREAKING NEWS",
      "DEVELOPING",
      "JUST IN",
      "LIVE",
      "URGENT"
    ],
    "valid_latin_acronyms": [
      "AFP",
      "AI",
      "AP",
      "BBC",
      "CGTN",
      "CNN",
      "EU",
      "FOX",
      "IDF",
      "IMF",
      "ISIS",
      "KSA",
      "NATO",
      "RT",
      "TV",
      "UAE",
      "UK",
      "UN",
      "US"
    ],
    "remove_branding": false,
    "branding_words": [],
    "branding_style": "words",
    "prefilter": null,
    "pure_identification_filter": true,
    "word_fixes": {}
  },
  "dedup": {
    "headline_window_sec": 200,
    "urgent_window_sec": 90,
    "urgent_cooldown_sec": 20,
    "headline_cooldown_sec": 15,
    "similarity": 0.85
  },
  "llm": {
    "enabled": true,
    "url": "http://localhost:11434/api/generate",
    "model": "qwen2.5:3b",
    "timeout_sec": 20,
    "profile": "english"
  },
  "qdrant": {
    "enabled": true,
    "host": "localhost",
    "port": 6333,
    "collection": "aljazeera_english_urgent_top_story",
    "embedding_model": "BAAI/bge-m3",
    "vector_size": 1024,
    "score_threshold": 0.7
  },
  "features": {
    "location_markers": false
  },
  "notes": [
    "Legacy source falls back to generic channel icon; preserved here."
  ]
}
